{
  "name": "dsh-evcanvas",
  "version": "0.0.1",
  "description": "EV Canvas — DSH unified session & multimedia creation workspace plugin",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/server/index.js",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/server",
    "dist/shared",
    "dist/ui",
    "dist/canvas",
    "src/client",
    "scripts/why.mjs",
    "scripts/check-compatibility.mjs",
    "compatibility.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "bin": {
    "evcanvas-why": "./scripts/why.mjs"
  },
  "scripts": {
    "why": "node scripts/why.mjs",
    "check:compatibility": "node scripts/check-compatibility.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && node scripts/rewrite-alias.mjs && vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/rewrite-alias.mjs",
    "pack:plugin": "npm run build && node scripts/pack-plugin.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "verifyDepsBeforeRun": false
  }
}
